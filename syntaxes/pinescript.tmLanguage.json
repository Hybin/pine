{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Pine Script",
	"patterns": [
		{
			"include": "#declaration"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#boolean"
		},
		{
			"include": "#type"
		},
		{
			"include": "#varDeclaration"
		},
		{
			"include": "#number"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#reserves"
		},
		{
			"include": "#object"
		},
		{
			"include": "#method"
		},
		{
			"include": "#property"
		},
		{
			"include": "#callable"
		},
		{
			"include": "#arguments"
		},
		{
			"include": "#variable"
		},
		{
			"include": "#keywords"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.pinescript",
				"match": "\\b(if|while|for|return|switch)\\b"
			}]
		},
		"reserves": {
			"patterns": [{
				"name": "variable.language.readonly.pinescript",
				"match": "\\b(open|high|low|close|volume|time)\\b"
			}]
		},
		"strings": {
			"name": "string.quoted.double.pinescript",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.pinescript",
					"match": "\\\\."
				}
			]
		},
		"comments": {
			"name": "comment.line.pinescript",
			"begin": "//",
			"end": "\n",
			"patterns": [
				{
					"name": "comment.line.pinescript",
					"match": "//.*"
				}
			]
		},
		"declaration": {
			"name": "constant.string.declaration.pinescript",
			"match": "//\\s*@version=\\d+"
		},
		"callable": {
			"name": "entity.name.function.pinescript",
			"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()"
		},
		"arguments": {
			"name": "entity.name.function.argument.pinescript",
			"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*=)"
		},
		"boolean": {
			"name": "keyword.operator.pinescript",
			"match": "\\b(true|false)\\b"
		},
		"type": {
			"name": "storage.type.pinescript",
			"match": "\\b(int|float|bool|string|color|label|line|box|table)\\b(?=\\s+[a-zA-Z_][a-zA-Z0-9_]*\\b\\s*=)"
		},
		"varDeclaration": {
			"name": "keyword.declaration.pinescript",
			"match": "\\b(varip|var|const|enum)\\b(?=\\s+[a-zA-Z_][a-zA-Z0-9_]*)"
		},
		"number": {
			"name": "constant.numeric.pinescript",
			"match": "\\b\\d+(\\.\\d+)?\\b"
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arithmetic.pinescript",
					"match": "\\+|-|\\*|/"
				},
				{
					"name": "keyword.operator.assignment.pinescript",
					"match": "="
				},
				{
					"name": "keyword.operator.comparison.pinescript",
					"match": "==|!=|<|>|<=|>="
				},
				{
					"name": "keyword.operator.logical.pinescript",
					"match": "&&|\\|\\|"
				}
			]
		},
		"object": {
			"name": "variable.other.object.pinescript",
			"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\.)"
		},
		"property": {
			"name": "variable.other.property.pinescript",
			"match": "(?<=\\.)\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?!\\s*\\()"
		},
		"method": {
			"name": "entity.name.function.pinescript",
			"match": "(?<=\\.)\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()"
		},
		"variable": {
			"name": "variable.other.readwrite.pinescript",
			"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?!\\s*=|\\s*\\.|\\s*\\()"
		},
		"color": {
			"name": "constant.color.pinescript",
			"match": "(?<=\\.)\\b(blue|orange|red|green|yellow|white|black|gray)\\b"
		}
	},
	"scopeName": "source.pine"
}